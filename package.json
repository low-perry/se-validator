{
  "name": "se-validator",
  "packageManager": "yarn@4.13.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "agent": "tsx src/index.ts agent",
    "validate": "tsx src/index.ts validate",
    "docs:search": "bash scripts/docs-search.sh",
    "docs:context": "bash scripts/docs-context.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "commander": "^14.0.3",
    "fast-xml-parser": "^5.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "playwright": "^1.59.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
